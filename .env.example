# Embedding API（OpenAI 兼容，可选；留空则降级为纯关键词搜索）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# --- v0.25 种子源（BT）----
# Nyaa / 蜜柑 / dmhy 三家 RSS 源（蜜柑 dmhy 详见 application.yml 对应置位；默认全关，装好环境按需开）
NYAA_PROVIDER_ENABLED=true  # 默认已开，仅需覆盖时设
# qBittorrent WebUI RPC（默认 http://127.0.0.1:8090，默认账号 admin/adminadmin——务必按实际改）
QBITTORRENT_ENABLED=true  # 默认已开，仅需覆盖时设
QBITTORRENT_BASE_URL=http://127.0.0.1:8090
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin  # 如你改过 qB 密码请覆盖

# 外站代理默认已写死 127.0.0.1:7890（application.yml videotagger.http-proxy）；换网络时覆盖
# VT_HTTP_PROXY_HOST=
# VT_HTTP_PROXY_PORT=
